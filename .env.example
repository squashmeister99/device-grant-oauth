# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Public host/port used in QR verification URLs (set to your laptop LAN IP for phone access)
KEYCLOAK_PUBLIC_HOST=localhost
KEYCLOAK_PUBLIC_PORT=8080

# Client app config (used by main.py, running natively on the host)
KEYCLOAK_REALM=device-grant-demo
KEYCLOAK_CLIENT_ID=device-client
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_SCOPES=openid profile email

# Device flow
DEVICE_CODE_LIFETIME=600
POLL_TIMEOUT=300
POLLING_INTERVAL_MIN=2
POLLING_INTERVAL_MAX=120

# Storage (local to this host)
TOKEN_STORAGE_PATH=./data/tokens.json

# Web UI
WEB_UI_PORT=8000
WEB_UI_HOST=127.0.0.1
OPEN_BROWSER=true

# Logging
LOG_LEVEL=INFO
